{
  "name": "ember-runes",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "main": "./dist-lib/ember-runes.js",
  "module": "./dist-lib/ember-runes.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/ember-runes.js"
    },
    "./style.css": "./dist-lib/ember-runes.css"
  },
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "vite --host --port 5175",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "pnpm build:lib"
  },
  "peerDependencies": {
    "gsap": "3.12.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.128.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "gsap": "3.12.5",
    "prettier": "^3.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.128.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.0"
  }
}
